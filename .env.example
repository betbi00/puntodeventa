# Este archivo es una plantilla. Copia a ".env" y llena los valores reales.
# ".env" NUNCA debe subirse al repositorio (ya está en .gitignore).

# Mercado Pago Point (Fase 5)
# 1. Entra a https://www.mercadopago.com.mx/developers/panel con la cuenta
#    que tiene vinculada la terminal Point del negocio.
# 2. En "Tus aplicaciones" crea o abre una aplicación, y copia el Access
#    Token de PRUEBA (empieza con "TEST-") para probar en sandbox primero.
#    El de producción empieza con "APP_USR-" — solo úsalo cuando ya hayan
#    probado todo con el de prueba.
MP_ACCESS_TOKEN=

# 3. Con el Access Token ya puesto arriba, corre esto para listar las
#    terminales asociadas a la cuenta y obtener el terminal_id:
#      ./venv/bin/python3 -c "from services import mercadopago_service as mp; print(mp.listar_terminales())"
MP_TERMINAL_ID=
